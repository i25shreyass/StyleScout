PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stylescout?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true

# Where the React app runs (used to build the links inside emails)
CLIENT_URL=http://localhost:5173

# --- Google reCAPTCHA v2 ("I'm not a robot" checkbox) ---
# Get keys: https://www.google.com/recaptcha/admin  (type: v2 Checkbox, domain: localhost)
# For a quick test you can use Google's public TEST secret below (always passes):
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- Email (Brevo or Resend) ---
# EMAIL_PROVIDER=brevo | resend
EMAIL_PROVIDER=brevo
# Brevo: SMTP & API > API Keys.  Resend: API Keys.
# Leave EMAIL_API_KEY empty to just print the email links in this terminal.
EMAIL_API_KEY=
# Must be a sender you verified in Brevo (Resend free tier: onboarding@resend.dev, sends only to your own account email)
EMAIL_FROM=
EMAIL_FROM_NAME=StyleScout
